{
	"$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"metadata": {
		"descripcion": "Frontend del estimador: App Service Linux F1 con identidad administrada y permiso para hablar con el Hosted Agent. Sin secretos."
	},
	"parameters": {
		"cuentaFoundry": { "type": "string" },
		"proyectoFoundry": { "type": "string", "defaultValue": "estimador" },
		"nombreAgente": { "type": "string", "defaultValue": "estimador-azure" },
		"sku": { "type": "string", "defaultValue": "F1", "allowedValues": ["F1", "B1"] },
		"limitePorHora": { "type": "int", "defaultValue": 30 }
	},
	"variables": {
		"etiquetas": { "proyecto": "estimador-azure-foundry" },
		"plan": "plan-estimador-web",
		"web": "[concat('app-estimador-web-', take(uniqueString(resourceGroup().id), 6))]",
		"agenteUrl": "[format('https://{0}.services.ai.azure.com/api/projects/{1}/agents/{2}/endpoint/protocols/openai/responses?api-version=v1', parameters('cuentaFoundry'), parameters('proyectoFoundry'), parameters('nombreAgente'))]",
		"rolFoundryAgentConsumer": "eed3b665-ab3a-47b6-8f48-c9382fb1dad6",
		"proyecto": "[resourceId('Microsoft.CognitiveServices/accounts/projects', parameters('cuentaFoundry'), parameters('proyectoFoundry'))]"
	},
	"resources": [
		{
			"type": "Microsoft.Web/serverfarms",
			"apiVersion": "2024-04-01",
			"name": "[variables('plan')]",
			"location": "[resourceGroup().location]",
			"tags": "[variables('etiquetas')]",
			"kind": "linux",
			"sku": { "name": "[parameters('sku')]" },
			"properties": { "reserved": true }
		},
		{
			"type": "Microsoft.Web/sites",
			"apiVersion": "2024-04-01",
			"name": "[variables('web')]",
			"location": "[resourceGroup().location]",
			"tags": "[variables('etiquetas')]",
			"kind": "app,linux",
			"identity": { "type": "SystemAssigned" },
			"dependsOn": ["[resourceId('Microsoft.Web/serverfarms', variables('plan'))]"],
			"properties": {
				"serverFarmId": "[resourceId('Microsoft.Web/serverfarms', variables('plan'))]",
				"httpsOnly": true,
				"siteConfig": {
					"linuxFxVersion": "PYTHON|3.13",
					"appCommandLine": "python server.py",
					"alwaysOn": false,
					"ftpsState": "Disabled",
					"minTlsVersion": "1.2",
					"appSettings": [
						{ "name": "AGENTE_URL", "value": "[variables('agenteUrl')]" },
						{ "name": "LIMITE_POR_HORA", "value": "[string(parameters('limitePorHora'))]" },
						{ "name": "SCM_DO_BUILD_DURING_DEPLOYMENT", "value": "true" }
					]
				}
			}
		},
		{
			"comments": "Sin usuario y contraseña de publicación: el código se sube con un token de Entra ID",
			"type": "Microsoft.Web/sites/basicPublishingCredentialsPolicies",
			"apiVersion": "2024-04-01",
			"name": "[concat(variables('web'), '/scm')]",
			"dependsOn": ["[resourceId('Microsoft.Web/sites', variables('web'))]"],
			"properties": { "allow": false }
		},
		{
			"type": "Microsoft.Web/sites/basicPublishingCredentialsPolicies",
			"apiVersion": "2024-04-01",
			"name": "[concat(variables('web'), '/ftp')]",
			"dependsOn": ["[resourceId('Microsoft.Web/sites', variables('web'))]"],
			"properties": { "allow": false }
		},
		{
			"comments": "Foundry Agent Consumer sobre el proyecto: solo puede invocar agentes, nada más",
			"type": "Microsoft.Authorization/roleAssignments",
			"apiVersion": "2022-04-01",
			"name": "[guid(variables('proyecto'), variables('web'), variables('rolFoundryAgentConsumer'))]",
			"scope": "[format('Microsoft.CognitiveServices/accounts/{0}/projects/{1}', parameters('cuentaFoundry'), parameters('proyectoFoundry'))]",
			"dependsOn": ["[resourceId('Microsoft.Web/sites', variables('web'))]"],
			"properties": {
				"roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', variables('rolFoundryAgentConsumer'))]",
				"principalId": "[reference(resourceId('Microsoft.Web/sites', variables('web')), '2024-04-01', 'full').identity.principalId]",
				"principalType": "ServicePrincipal"
			}
		}
	],
	"outputs": {
		"web": { "type": "string", "value": "[variables('web')]" },
		"url": { "type": "string", "value": "[concat('https://', reference(resourceId('Microsoft.Web/sites', variables('web')), '2024-04-01').defaultHostName)]" },
		"agenteUrl": { "type": "string", "value": "[variables('agenteUrl')]" }
	}
}
